# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3333/api

# App Configuration
NEXT_PUBLIC_APP_NAME="Marketplace Multi-ONG"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/marketplace?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL=http://localhost:3000

# Session Configuration (in seconds)
# Tempos recomendados:
# - Desenvolvimento: 86400 (1 dia)
# - Produção Normal: 604800 (7 dias)
# - Produção Intenso: 2592000 (30 dias)
# - Aplicações Sensíveis: 3600 (1 hora)
SESSION_MAX_AGE=2592000
JWT_MAX_AGE=2592000
