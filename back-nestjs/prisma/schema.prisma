generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ETAPA 1 - Entidades Principais
// ============================================

model Organization {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  email       String    @unique
  description String?
  logoUrl     String?   @map("logo_url")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users    User[]
  products Product[]

  @@map("organizations")
}

enum UserRole {
  ADMIN
  ONG_MANAGER
  ONG_STAFF
  CUSTOMER
}

model User {
  id             String    @id @default(uuid())
  organizationId String?   @map("organization_id")
  email          String    @unique
  passwordHash   String    @map("password_hash")
  fullName       String    @map("full_name")
  role           UserRole  @default(CUSTOMER)
  isActive       Boolean   @default(true) @map("is_active")
  emailVerified  DateTime? @map("email_verified_at")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  orders       Order[]

  @@index([organizationId])
  @@map("users")
}

model Product {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  description    String?
  price          Decimal   @db.Decimal(10, 2)
  category       String
  imageUrl       String?   @map("image_url")
  stockQty       Int       @map("stock_qty")
  weightGrams    Int       @map("weight_grams")
  isActive       Boolean   @default(true) @map("is_active")
  sku            String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  orderItems   OrderItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([category])
  @@index([isActive, stockQty])
  @@map("products")
}

enum OrderStatus {
  PENDING
  PAYMENT_PROCESSING
  PAYMENT_FAILED
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id              String      @id @default(uuid())
  customerId      String      @map("customer_id")
  orderNumber     String      @unique @map("order_number")
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @db.Decimal(10, 2) @map("total_amount")
  shippingCost    Decimal     @default(0) @db.Decimal(10, 2) @map("shipping_cost")
  shippingDetails Json        @map("shipping_details")
  paymentMethod   String?     @map("payment_method")
  paymentDetails  Json?       @map("payment_details")
  notes           String?
  idempotencyKey  String?     @unique @map("idempotency_key")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  confirmedAt     DateTime?   @map("confirmed_at")
  cancelledAt     DateTime?   @map("cancelled_at")

  customer User        @relation(fields: [customerId], references: [id])
  items    OrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String   @map("order_id")
  organizationId String   @map("organization_id")
  productId      String   @map("product_id")
  productName    String   @map("product_name")
  productPrice   Decimal  @db.Decimal(10, 2) @map("product_price")
  quantity       Int
  subtotal       Decimal  @db.Decimal(10, 2)
  shippingCost   Decimal  @default(0) @db.Decimal(10, 2) @map("shipping_cost")
  weightGrams    Int      @map("weight_grams")
  createdAt      DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([organizationId])
  @@index([productId])
  @@map("order_items")
}

model SearchLog {
  id               String   @id @default(uuid())
  userId           String?  @map("user_id")
  searchQuery      String   @map("search_query")
  aiInterpretation Json?    @map("ai_interpretation")
  aiSuccess        Boolean  @map("ai_success")
  fallbackUsed     Boolean  @map("fallback_used")
  resultsCount     Int      @default(0) @map("results_count")
  latencyMs        Int?     @map("latency_ms")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([aiSuccess])
  @@map("search_logs")
}