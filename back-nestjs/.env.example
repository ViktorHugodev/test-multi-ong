# Database
DATABASE_URL="postgresql://user:password@localhost:5432/erp_db"

# JWT (mantido para compatibilidade durante migração)
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-change-in-production
JWT_EXPIRATION=15m

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=3000

# Redis (para Bull queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# Server
PORT=3333
NODE_ENV=development

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_CACHE_ACCESS=false

# Circuit Breaker
SEARCH_CIRCUIT_BREAKER_THRESHOLD=3
SEARCH_CIRCUIT_BREAKER_TIMEOUT=120000

# Cache
CACHE_WARMING_ENABLED=true
