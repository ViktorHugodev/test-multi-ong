# Database
DATABASE_URL="postgresql://user:password@localhost:5432/erp_db"

# JWT (mantido para compatibilidade durante migração)
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-change-in-production
JWT_EXPIRATION=15m

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=3000

# Redis (para Bull queues e idempotência)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Server
PORT=3333
NODE_ENV=development

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_CACHE_ACCESS=false

# Circuit Breaker
SEARCH_CIRCUIT_BREAKER_THRESHOLD=3
SEARCH_CIRCUIT_BREAKER_TIMEOUT=120000

# Cache
CACHE_WARMING_ENABLED=true

# Payment Gateway Simulation
PAYMENT_SUCCESS_RATE=0.85
PAYMENT_TRANSIENT_FAIL_RATE=0.10
PAYMENT_PERMANENT_FAIL_RATE=0.05
PAYMENT_MIN_DELAY=500
PAYMENT_MAX_DELAY=3000

# Queue Configuration
QUEUE_PAYMENT_MAX_RETRIES=5
QUEUE_PAYMENT_BACKOFF_DELAY=2000
QUEUE_NOTIFICATION_MAX_RETRIES=3
QUEUE_NOTIFICATION_BACKOFF_DELAY=1000
QUEUE_JOB_LOG_TTL=604800
